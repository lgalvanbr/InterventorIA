{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api?path=uploads/:path*" },
    { "source": "/((?!api|uploads|frentes|assets).*)$", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "src/data/saved_weekly_reports.json"
    }
  }
}
